[Unit]
Description=QUANSEQ PQC OpenSSH daemon on port 2222
After=network.target

[Service]
Type=simple
ExecStartPre=/opt/openssh-pqc/sbin/sshd -t -f /opt/openssh-pqc/etc/sshd_config
ExecStart=/opt/openssh-pqc/sbin/sshd -D -f /opt/openssh-pqc/etc/sshd_config
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
