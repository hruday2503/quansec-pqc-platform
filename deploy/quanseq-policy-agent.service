[Unit]
Description=QUANSEQ restricted host policy controller
After=network.target

[Service]
Type=simple
User=root
Group=quanseq-control
RuntimeDirectory=quanseq
RuntimeDirectoryMode=0750
WorkingDirectory=/opt/quanseq/backend
Environment=QUANSEQ_SWANCTL_CONFIG=/etc/quanseq-strongswan/swanctl/swanctl.conf
Environment=QUANSEQ_SWANCTL_BIN=/opt/quanseq-pqc/sbin/swanctl
ExecStart=/usr/bin/python3 /opt/quanseq/backend/host_policy_agent.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
UMask=0007
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=-/etc/quanseq-strongswan -/opt/openssh-pqc/etc /run/quanseq

[Install]
WantedBy=multi-user.target
