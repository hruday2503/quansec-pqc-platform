# ── Python ───────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc

# ── Environment / secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*_key
*_key.pub
*-cert.pub
id_ed25519*
id_rsa*
quanseq_ca
quanseq_ca.pub
known_hosts

# ── TLS development PKI ──────────────────────────────────────────────────────
# scripts/generate_tls_certs.py writes outside the repo by default, but a stray
# --cert-dir must never leak key material into a commit.
*.key
*.csr
*.srl
certs/
quanseq/certs/

# ── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo

# ── Sibling checkouts that live inside this tree ─────────────────────────────
# Each of these carries its own .git, so `git add -A` would stage them as
# gitlinks — submodule stubs with no .gitmodules, which clone as empty
# directories. They are separate repositories and are versioned there.
quanseq-pqc-platform/
TLS-SMOAD-HSC/

# ── Claude Code local state ──────────────────────────────────────────────────
# worktrees/ holds live git worktrees; settings.local.json is per-machine.
.claude/worktrees/
.claude/settings.local.json

# ── Archives, dumps, logs ────────────────────────────────────────────────────
*.tar.gz
*.zip
*.log
*.dump

# ── SQL ──────────────────────────────────────────────────────────────────────
# Ignore ad-hoc dumps and scratch SQL, but the schema migrations are source
# code — the documented setup depends on them being in the repository.
*.sql
!quanseq/migrations/*.sql

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store

# ── PQC TLS runtime (built binaries, logs, PIDs, evidence) ──────────────────
runtime/
*.pid
