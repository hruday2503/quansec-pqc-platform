# ── Python ───────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc

# ── Environment / secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*_key
*_key.pub
*-cert.pub
id_ed25519*
id_rsa*
quansec_ca
quansec_ca.pub
known_hosts

# ── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
.next/
out/

# ── Archives, dumps, logs ────────────────────────────────────────────────────
*.tar.gz
*.zip
*.log
*.dump

# ── SQL ──────────────────────────────────────────────────────────────────────
# Ignore ad-hoc dumps and scratch SQL, but the schema migrations are source
# code — the documented setup depends on them being in the repository.
*.sql
!quansec/migrations/*.sql

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
