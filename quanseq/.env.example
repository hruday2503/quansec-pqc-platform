# =============================================================================
# QUANSEQ backend environment
# =============================================================================
# Copy to .env and fill in real values:
#     cp .env.example .env
#
# Every variable below has a default in core/config.py, so the application
# boots without a .env at all — but the defaults are insecure placeholders.
# setup_backend.sh generates a .env with a random JWT_SECRET on first run.
#
# .env is git-ignored. Never commit it.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# asyncpg DSN. Must match the role/database created by setup_backend.sh
# or provision_postgres.sh.
DATABASE_URL=postgresql://quanseq_user:CHANGE_ME@localhost:5432/quanseq_db

# ── Redis ────────────────────────────────────────────────────────────────────
# Pub/sub bus for the live WebSocket feed (channel: quanseq:live).
# The platform degrades gracefully to 5-second polling if Redis is down.
REDIS_URL=redis://localhost:6379/0

# ── Authentication ───────────────────────────────────────────────────────────
# ── Authentication ───────────────────────────────────────────────────────────
# REQUIRED. No default exists in core/config.py: a secret compiled into the
# source is a published key, so the application refuses to start without this.
#
# HS384 needs at least 48 bytes (96 hex characters). Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(48))"
#
# Rotating it invalidates every existing session; users simply log in again.
JWT_SECRET=CHANGE_ME_96_HEX_CHARACTERS

# Token identity. Verified on every request — a token minted for a different
# issuer or audience is rejected even when the signature is valid.
JWT_ISSUER=quanseq
JWT_AUDIENCE=quanseq-api

# Access tokens are stateless and cannot be revoked before they expire, so this
# window is the blast radius of a stolen one. Revocation bites at the refresh
# layer instead.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ── Refresh cookie ───────────────────────────────────────────────────────────
# The browser refresh token lives in a Secure/HttpOnly/SameSite cookie scoped
# to /api/auth. Never in localStorage.
#
# AUTH_COOKIE_SECURE=false is ONLY for local HTTP development: a browser drops
# a Secure cookie over plain HTTP, so leaving it true breaks login on
# http://localhost. Set it back to true anywhere reachable over the network.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=quanseq_refresh
REFRESH_COOKIE_PATH=/api/auth
CSRF_COOKIE_NAME=quanseq_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# ── Login throttling ─────────────────────────────────────────────────────────
# Counted on IP + email, so one attacker cannot lock out an account they merely
# know the address of. Redis is primary; PostgreSQL auth_throttle is fallback.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
REFRESH_RATE_LIMIT=60
REFRESH_RATE_WINDOW_SECONDS=300

# Trust X-Forwarded-For for the client IP. Leave false unless a reverse proxy
# sets it: any client can send that header, and trusting it lets an attacker
# forge the address in the audit log and evade per-IP throttling.
TRUSTED_PROXY=false

# Seeded admin password, read by seed_admin.py. Change before first run.
# Account: admin@quanseq.io — hashed with Argon2id.
ADMIN_PASSWORD=CHANGE_ME

# ── IPsec ────────────────────────────────────────────────────────────────────
# StrongSwan control socket. Must be readable by the backend user.
# For the netns lab: /var/run/ns-left/charon.vici
VICI_SOCKET=/var/run/charon.vici
IPSEC_POLL_INTERVAL=5

# ── SSH ──────────────────────────────────────────────────────────────────────
SSH_AUTH_LOG=/var/log/auth.log
SSHD_CONFIG=/etc/ssh/sshd_config
SSH_POLL_INTERVAL=5

# ── SSH certificate authority ────────────────────────────────────────────────
# Private key used to sign user certificates. Read directly by
# protocols/ssh/ca.py (not via Settings). The .pub is derived by appending .pub.
# This key can mint SSH access to every server trusting the CA — protect it.
QUANSEQ_CA_KEY=/home/CHANGE_ME/quanseq-ca/quanseq_ca

# ── Zero Trust audit ─────────────────────────────────────────────────────────
# Where to read certificate-authentication events from.
QUANSEQ_ZT_LOG=/var/log/auth.log

# Optional: pull the auth log from a remote host over the PQC SSH channel,
# for when QUANSEQ runs on VM A but authentications happen on VM B.
# Requires a narrowly-scoped passwordless sudo for `tail` on the remote host.
# QUANSEQ_ZT_REMOTE=hd6441@192.168.1.7
# QUANSEQ_ZT_KEY=/home/CHANGE_ME/.ssh/quanseq_zt
# QUANSEQ_ZT_CERT=/home/CHANGE_ME/.ssh/quanseq_zt-cert.pub

# ── TLS transport service ────────────────────────────────────────────────────
# QUANSEQ runs a real TLS 1.3 service as a SEPARATE PROCESS on its own port and
# connects to it as a client. Start it with:
#     bash scripts/run_tls_service.sh
#
# Point QUANSEQ_TLS_HOST at a peer machine to run the service there instead;
# nothing else in the platform changes.
QUANSEQ_TLS_ENABLED=true
QUANSEQ_TLS_HOST=127.0.0.1
QUANSEQ_TLS_PORT=8443
# Used only by the service process. Set to 0.0.0.0 to accept remote clients.
QUANSEQ_TLS_BIND_HOST=127.0.0.1
# Must appear in the server certificate's SAN, or verification fails.
QUANSEQ_TLS_SERVER_HOSTNAME=localhost

# ── TLS certificates ─────────────────────────────────────────────────────────
# Development PKI. Generate with:
#     python scripts/generate_tls_certs.py --cert-dir ~/quanseq-certs
# Keep this directory OUTSIDE the repository. Private keys are written mode 600
# and must never be committed. This is not production PKI — the CA private key
# sits on disk beside the server key.
QUANSEQ_TLS_CERT_DIR=/home/CHANGE_ME/quanseq-certs
# Individual paths default to <CERT_DIR>/{ca,server,client}.{crt,key}.
# QUANSEQ_TLS_CA_CERT=
# QUANSEQ_TLS_SERVER_CERT=
# QUANSEQ_TLS_SERVER_KEY=
# QUANSEQ_TLS_CLIENT_CERT=
# QUANSEQ_TLS_CLIENT_KEY=

# ── TLS behaviour ────────────────────────────────────────────────────────────
# Mutual TLS: the service requires a client certificate signed by the CA above,
# and the backend presents one.
QUANSEQ_TLS_MTLS=false
QUANSEQ_TLS_TIMEOUT=10
# Per-connection handshake cap on the server, so a client that opens TCP and
# sends nothing cannot occupy a handshake worker.
QUANSEQ_TLS_HANDSHAKE_TIMEOUT=5
QUANSEQ_TLS_MAX_CLIENTS=10
QUANSEQ_TLS_MAX_CONCURRENT_HANDSHAKES=8

# ── Hybrid post-quantum key exchange ─────────────────────────────────────────
# true gates startup on a runtime that HAS the hybrid group, which needs a
# Python linked against OpenSSL 3.5.5+. It does NOT make hybrid mandatory:
# Python's ssl module cannot select TLS 1.3 groups, so a classical X25519-only
# client still connects. Leave false on stock Ubuntu 24.04 (OpenSSL 3.0.13),
# where the group does not exist at all.
QUANSEQ_TLS_REQUIRE_HYBRID=false
QUANSEQ_TLS_HYBRID_GROUP=X25519MLKEM768
# Used for capability probes and out-of-band group verification. Point at a
# newer build if you have one, e.g. /opt/openssl-3.5/bin/openssl
QUANSEQ_TLS_OPENSSL_BIN=openssl

# ── TLS observability ────────────────────────────────────────────────────────
# Logs every application payload in cleartext. Local debugging only.
QUANSEQ_TLS_LOG_PAYLOADS=false
QUANSEQ_TLS_POLL_INTERVAL=30

# Reserved for a future collector that tails nginx TLS access logs to observe
# traffic to servers QUANSEQ does not run. Nothing reads this today.
NGINX_ACCESS_LOG=/var/log/nginx/access.log

# ── VPN (reserved — module not implemented) ──────────────────────────────────
WG_INTERFACE=wg0
VPN_POLL_INTERVAL=5

# ── Runtime ──────────────────────────────────────────────────────────────────
APP_ENV=development
# Several failures (SIEM audit gather, ZT log read, per-protocol metric blocks)
# are logged at DEBUG — raise this to see them.
LOG_LEVEL=INFO
